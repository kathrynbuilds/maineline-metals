# Copy to .env and fill in. .env is git-ignored — never commit real values.

# Airtable personal access token with data.records:read/write + schema.bases:read
# on the "Genesis Logistics CRM" base (app2iq77VubxkxxzE)
AIRTABLE_PAT=

# FMCSA QCMobile developer webkey (free): https://mobile.fmcsa.dot.gov/QCDevsite/
FMCSA_WEBKEY=

# Anthropic API key for the email intake classifier (Phase 4)
ANTHROPIC_API_KEY=

# Optional: Socrata app token for data.transportation.gov (raises rate limits;
# census refresh works without it)
SODA_APP_TOKEN=

# Phase 4 IMAP poller (only needed if you run the IMAP adapter)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
